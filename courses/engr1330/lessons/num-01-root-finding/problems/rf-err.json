        }
      ]
    }
  },
  "hints": [
    "e_a = |new − old| / |new| × 100.",
    "Difference [$n] − [$o].",
    "Divide by [$n] and multiply by 100."
  ],
  "solution": "$|[$n]-[$o]|/|[$n]|\\times100$.",
  "tests": {

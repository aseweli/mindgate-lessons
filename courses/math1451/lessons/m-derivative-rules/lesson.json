    {
      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Tangent from first principles",
          "problem": "Find the tangent to $x^2-1$ at $x=2$.",
          "answer": "$y-3=4(x-2)$.",
          "steps": [
            {
              "title": "Expand",
              "md": "$[(2+h)^2-4]/h=4+h$ for $h\\ne0$.",
              "why": "The constants cancel before division."
            },
            {
              "title": "Build the line",
              "md": "$f(2)=3$ and $f^\\prime(2)=4$.",
              "why": "Point-slope form combines the point and the derivative."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "Product of unlike functions",
          "problem": "Differentiate $x^2\\ln x$.",
          "answer": "$2x\\ln x+x$ for $x>0$.",
          "steps": [
            {
              "title": "Apply product rule",
              "md": "$(2x)\\ln x+x^2(1/x)$.",
              "why": "Either factor can supply the rate of change."
            },
            {
              "title": "Simplify",
              "md": "$2x\\ln x+x$.",
              "why": "The positive domain remains in force."
            }
          ]
        }
      ]
    },

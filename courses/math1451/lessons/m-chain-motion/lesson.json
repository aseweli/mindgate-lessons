      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Product with an inner function",
          "problem": "Differentiate $x\\cos(3x^2)$.",
          "answer": "$\\cos(3x^2)-6x^2\\sin(3x^2)$.",
          "steps": [
            {
              "title": "Start outside",
              "md": "$1\\cdot\\cos(3x^2)+x(\\cos(3x^2))^\\prime$.",
              "why": "The outer operation is a product."
            },
            {
              "title": "Finish the chain",
              "md": "$(\\cos(3x^2))^\\prime=-\\sin(3x^2)\\cdot6x$.",
              "why": "The inside is $3x^2$."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "Distance through a turn",
          "problem": "For $s(t)=t^2-4t$, find total distance on $[0,5]$.",
          "answer": "$13$ distance units.",
          "steps": [
            {
              "title": "Find the turn",
              "md": "$v(t)=2t-4$, negative before 2 and positive after.",
              "why": "Position reverses at $t=2$."
            },
            {
              "title": "Add magnitudes",
              "md": "$s(0)=0$, $s(2)=-4$, $s(5)=5$. Distance is $4+9=13$.",
              "why": "Displacement of 5 misses the first leg."
            }
          ]
        }
      ]
    },

        {
          "type": "formulas",
          "title": "Formulas to know",
          "items": [
            {
              "label": "Definition",
              "latex": "f^\\prime(a)=\\lim_{h\\to0}\\frac{f(a+h)-f(a)}h",
              "note": "Simplify before setting h to zero."
            },
            {
              "label": "Power",
              "latex": "(x^n)^\\prime=nx^{n-1}",
              "note": "Where the derivative exists."
            },
            {
              "label": "Product and quotient",
              "latex": "(fg)^\\prime=f^\\prime g+fg^\\prime,\\quad(f/g)^\\prime=\\frac{f^\\prime g-fg^\\prime}{g^2}",
              "note": "Keep the signs in order."
            }
          ]
        },
        {
          "type": "callout",
          "style": "warn",
          "title": "Common errors",
          "md": "Cancel factors, and keep the original domain. A product needs two terms. The derivative of a constant is zero."
        },
        {
          "type": "callout",
          "style": "exam",
          "title": "Written exam practice",
          "md": "When the prompt says “from the definition,” use the limit even if you already know the power rule."
        }
      ]
    },

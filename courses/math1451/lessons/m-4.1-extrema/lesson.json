    {
      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Cubic on a closed interval",
          "problem": "Find absolute extrema of $f(x)=x^3-3x$ on $[-2,3]$.",
          "answer": "Minimum $-2$ at $x=-2,1$ and maximum $18$ at $x=3$.",
          "steps": [
            {
              "title": "Find candidates",
              "md": "$f^\\prime=3(x^2-1)$, so use $-2,-1,1,3$.",
              "why": "Both stationary points are inside the interval and the endpoints must be tested."
            },
            {
              "title": "Compare function values",
              "md": "The four values are $-2,2,-2,18$.",
              "why": "Ties for an absolute extreme can occur."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "Include a corner",
          "problem": "Find absolute extrema of $g(x)=|x-2|+1$ on $[0,5]$.",
          "answer": "Minimum $1$ at 2 and maximum $4$ at 5.",
          "steps": [
            {
              "title": "Find the corner",
              "md": "$g^\\prime=-1$ for $x<2$ and $+1$ for $x>2$.",
              "why": "The derivative is undefined at 2, where $g$ exists."
            },
            {
              "title": "Evaluate candidates",
              "md": "$g(0)=3$, $g(2)=1$, $g(5)=4$.",
              "why": "Comparing outputs includes the endpoints."
            }
          ]
        }
      ]
    },

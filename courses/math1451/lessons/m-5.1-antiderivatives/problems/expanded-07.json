{
  "title": "Recover position from acceleration",
  "difficulty": 4,
  "minutes": 6,
  "tags": [
    "exam3"
  ],
  "exact": true,
  "vars": {
    "a": {
      "pick": [
        2,
        3
      ]
    }
  },
  "statement": "A particle has $a(t)=2([$a])$, $v(0)=3$, and $s(0)=1$. Find $s(2)$.\n\n[__________]{a}",
  "hints": [
    "Integrate acceleration to get velocity.",
    "Use the initial velocity before integrating again.",
    "Apply the initial position and then evaluate."
  ],
  "solution": "$v(t)=2([$a])t+3$, so $s(t)=[$a]t^2+3t+1$. At two seconds, $s(2)=4([$a])+7$.",
  "answers": {
    "a": {
      "type": "number",
      "value": "4*a+7",
      "feedback": [
        {
          "answer": "4*a+1",
          "message": "Apply the initial position and then evaluate."
        }
      ],
      "allow": [
        "DNE",
        "INF"
      ],
      "tol": 1e-08
    }
  },
  "tests": {
    "a": {
      "right": [
        "(2*(4*([$a])+7))/2"
      ],
      "wrong": [
        "4*([$a])+1"
      ]
    }
  }
}

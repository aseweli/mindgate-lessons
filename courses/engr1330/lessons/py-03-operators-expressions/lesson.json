        {
          "type": "worked_example",
          "title": "Order of evaluation",
          "problem": "Show the order of operations and the value of x for `x = (3 * 9 * (3 + (9 * 3 / (3))))`.",
          "steps": [
            {
              "md": "(3) = 3; 9 * 3 / 3 = 9.0.",
              "title": "Innermost parentheses",
              "why": "`/` makes a float."
            },
            {
              "md": "3 + 9.0 = 12.0.",
              "title": "Next level"
            },
            {
              "md": "3 * 9 * 12.0 = 324.0.",
              "title": "Outer product",
              "why": "Left to right."
            },
            {
              "md": "```python\nx = (3 * 9 * (3 + (9 * 3 / (3))))\nprint(x)\n```\n\n```text\n324.0\n```",
              "title": "Check"
            }
          ],
          "answer": "324.0"
        },
        {
          "type": "worked_example",
          "title": "Remainders for even/odd and digits",
          "problem": "Use `%` and `//` to test if 47 is odd and to split 47 into tens and ones.",
          "steps": [
            {
              "md": "47 % 2 = 1 → odd.",
              "title": "Odd?",
              "why": "Even numbers leave remainder 0."
            },
            {
              "md": "47 // 10 = 4, 47 % 10 = 7.",
              "title": "Digits",
              "why": "Floor-divide by 10 drops the last digit."
            },
            {
              "md": "```python\nn = 47\nprint(n % 2 == 1)\nprint(n // 10, n % 10)\n```\n\n```text\nTrue\n4 7\n```",
              "title": "Complete program"
            }
          ],
          "answer": "True; 4 and 7."
        }
      ]
    },

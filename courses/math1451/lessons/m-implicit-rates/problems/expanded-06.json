{
  "title": "A fixed-length ladder",
  "difficulty": 4,
  "minutes": 6,
  "tags": [
    "exam2"
  ],
  "exact": true,
  "vars": {
    "a": {
      "pick": [
        2,
        3,
        4
      ]
    }
  },
  "statement": "A 10-ft ladder has base 6 ft from the wall and moving away at $[$a]$ ft/s. What is the signed rate of the top’s height?\n\n[__________]{a}",
  "hints": [
    "The top is 8 ft high.",
    "Differentiate $x^2+y^2=100$.",
    "A positive base rate gives a negative height rate."
  ],
  "solution": "$y'=-(6/8)([$a])=-3([$a])/4$ ft/s, using time derivatives here.",
  "answers": {
    "a": {
      "type": "number",
      "value": "-3*a/4",
      "feedback": [
        {
          "answer": "3*a/4",
          "message": "A positive base rate gives a negative height rate."
        }
      ],
      "allow": [
        "DNE",
        "INF"
      ],
      "tol": 1e-08
    }
  },
  "tests": {
    "a": {
      "right": [
        "(2*(-3*([$a])/4))/2"
      ],
      "wrong": [
        "3*([$a])/4"
      ]
    }
  }
}

  "statement": "Which line draws 1,000 values from a normal distribution with mean 7 and SD 1.5?\n\n[_]{a}",
  "answers": {
    "a": {
      "type": "choice",
      "choices": [
        "`np.random.normal(1.5, 7, 1000)`",
        "`np.random.choice(7, 1.5, 1000)`",
        "`np.random.normal(7, 1.5, 1000)`",
        "`np.random.normal(7, 1.5**2, 1000)`"
      ],
      "correct": 2,
      "explanations": [
        "Mean and SD are swapped.",
        "`choice` picks from a collection; it doesn't make normal values.",
        "Correct: mean, SD, size.",
        "The second argument is the SD, not the variance."
      ],
      "shuffle": false
    }
  },
  "hints": [
    "The order is (mean, sd, size).",
    "The SD is 1.5, not its square.",
    "Only one call uses that order."
  ],
  "solution": "`np.random.normal(mean, sd, size)`.",
  "tests": {
    "a": {
      "right": [
        "2"
      ],
      "wrong": [
        "0"
      ]
    }
  }
}

    {
      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Rationalize",
          "problem": "Evaluate $\\lim_{x\\to0}(\\sqrt{9+x}-3)/x$.",
          "answer": "$1/6$.",
          "steps": [
            {
              "title": "Multiply by the conjugate",
              "md": "$\\frac{\\sqrt{9+x}-3}{x}\\frac{\\sqrt{9+x}+3}{\\sqrt{9+x}+3}=\\frac{x}{x(\\sqrt{9+x}+3)}$.",
              "why": "The numerator becomes a difference of squares."
            },
            {
              "title": "Cancel and substitute",
              "md": "$\\lim_{x\\to0}1/(\\sqrt{9+x}+3)=1/6$.",
              "why": "The new denominator stays nonzero."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "Opposite signs",
          "problem": "Evaluate $\\lim_{x\\to1} 3/(x-1)$.",
          "answer": "DNE.",
          "steps": [
            {
              "title": "Read the sides",
              "md": "The left tends to $-\\infty$ and the right to $+\\infty$.",
              "why": "The numerator is positive and the denominator changes sign."
            },
            {
              "title": "Compare",
              "md": "The sides do not agree.",
              "why": "A two-sided limit needs matching behavior."
            }
          ]
        }
      ]
    },

  "statement": "What is the slope of the line through $(1,2)$ and $(3,2+[$a])$?\n\n[__________]{a}",
  "hints": [
    "Use rise over run.",
    "The run is $3-1$.",
    "Divide the change in $y$ by the change in $x$."
  ],
  "solution": "The slope is $((2+[$a])-2)/(3-1)=[$a]/2$.",
  "answers": {
    "a": {

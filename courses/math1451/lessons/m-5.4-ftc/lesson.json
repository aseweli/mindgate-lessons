    {
      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Exact endpoint evaluation",
          "problem": "Compute $\\int_1^3(2x-x^{-2})\\,dx$.",
          "answer": "$22/3$.",
          "steps": [
            {
              "title": "Find an antiderivative",
              "md": "$F(x)=x^2+1/x$.",
              "why": "Differentiating $1/x$ gives $-x^{-2}$."
            },
            {
              "title": "Subtract",
              "md": "$F(3)-F(1)=(9+1/3)-(1+1)=22/3$.",
              "why": "Parentheses preserve the lower-endpoint signs."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "Two moving bounds",
          "problem": "Differentiate $H(x)=\\int_{x}^{x^2}\\cos(t^3)\\,dt$.",
          "answer": "$2x\\cos(x^6)-\\cos(x^3)$.",
          "steps": [
            {
              "title": "Upper contribution",
              "md": "$\\cos((x^2)^3)\\cdot2x$.",
              "why": "Substitute into the integrand and multiply by the rate of the upper limit."
            },
            {
              "title": "Lower contribution",
              "md": "Subtract $\\cos(x^3)\\cdot1$.",
              "why": "Raising the lower bound removes accumulation."
            }
          ]
        }
      ]
    },

          "type": "formulas",
          "title": "Formulas to know",
          "items": [
            {
              "label": "Chain rule",
              "latex": "\\frac{d}{dx}f(g(x))=f^\\prime(g(x))g^\\prime(x)",
              "note": "One factor per layer."
            },
            {
              "label": "Motion",
              "latex": "v=s^\\prime,\\quad a=s^{\\prime\\prime},\\quad \\mathrm{speed}=|v|",
              "note": "Velocity and speed have the same units."
            }
          ]
        },
        {
          "type": "callout",
          "style": "warn",
          "title": "Common errors",
          "md": "Keep the inner derivative, apply the product rule when needed, and split distance at direction changes."
        },
        {
          "type": "callout",
          "style": "exam",
          "title": "Written exam practice",
          "md": "Mark the times where velocity is zero and show signs before deciding where a particle reverses or speeds up."
        }
      ]

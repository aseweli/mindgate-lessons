{
  "title": "Factor a difference of cubes",
  "difficulty": 1,
  "minutes": 3,
  "tags": [
    "exam1"
  ],
  "exact": true,
  "vars": {
    "a": {
      "pick": [
        2,
        3
      ]
    }
  },
  "statement": "Evaluate $\\lim_{x\\to[$a]}(x^3-[$a]^3)/(x-[$a])$.\n\n[__________]{a}",
  "hints": [
    "Substitution initially gives $0/0$.",
    "Factor the difference of cubes.",
    "The quotient has three equal terms at the limit."
  ],
  "solution": "For $x\\ne[$a]$, cancel the common factor to leave $x^2+[$a]x+[$a]^2$. Substitution gives $3([$a])^2$.",
  "answers": {
    "a": {
      "type": "number",
      "value": "3*a^2",
      "feedback": [
        {
          "answer": "a^2",
          "message": "The quotient has three equal terms at the limit."
        }
      ],
      "allow": [
        "DNE",
        "INF"
      ],
      "tol": 1e-08
    }
  },
  "tests": {
    "a": {
      "right": [
        "(2*(3*([$a])^2))/2"
      ],
      "wrong": [
        "([$a])^2"
      ]
    }
  }
}

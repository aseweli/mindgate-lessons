    {
      "id": "examples",
      "title": "Examples",
      "blocks": [
        {
          "type": "worked_example",
          "title": "Apply twice",
          "problem": "Evaluate $\\lim_{x\\to0}(1-\\cos x)/x^2$.",
          "answer": "$1/2$.",
          "steps": [
            {
              "title": "Check the form",
              "md": "Both numerator and denominator approach 0.",
              "why": "The two functions are differentiable near zero and $2x\\ne0$ off zero."
            },
            {
              "title": "Differentiate separately",
              "md": "The limit becomes $\\lim_{x\\to0}\\sin x/(2x)$, still $0/0$.",
              "why": "A second application is legal."
            },
            {
              "title": "Evaluate",
              "md": "$\\lim_{x\\to0}\\cos x/2=1/2$.",
              "why": "The new denominator is constant and nonzero."
            }
          ]
        },
        {
          "type": "worked_example",
          "title": "An indeterminate power",
          "problem": "Evaluate $\\lim_{x\\to0^+}(1+3x)^{1/x}$.",
          "answer": "$e^3$.",
          "steps": [
            {
              "title": "Take logs",
              "md": "$\\ln y=\\ln(1+3x)/x$.",
              "why": "This turns $1^\\infty$ into a $0/0$ quotient."
            },
            {
              "title": "Evaluate the log limit",
              "md": "The derivative quotient is $3/(1+3x)\\to3$.",
              "why": "Differentiate each piece separately."
            },
            {
              "title": "Undo the log",
              "md": "$y\\to e^3$.",
              "why": "The exponential is continuous."
            }
          ]
        }
      ]
    },

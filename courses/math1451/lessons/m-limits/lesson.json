          "items": [
            {
              "label": "Two-sided limit",
              "latex": "\\lim_{x\\to a^-}f(x)=\\lim_{x\\to a^+}f(x)=L",
              "note": "Both sides must agree."
            },
            {
              "label": "Small-angle limit",
              "latex": "\\lim_{u\\to0}\\frac{\\sin u}{u}=1",
              "note": "Radians."
            }
          ]

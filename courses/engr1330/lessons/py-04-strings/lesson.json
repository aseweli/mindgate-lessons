        {
          "type": "worked_example",
          "title": "Slice a part number",
          "problem": "From `pid = 'TX-2026-0451'` get the prefix, the year, the last 4 digits and the reversed ID.",
          "steps": [
            {
              "md": "`pid[0:2]` → 'TX'.",
              "title": "Prefix",
              "why": "Indices 0 and 1."
            },
            {
              "md": "`pid[3:7]` → '2026'.",
              "title": "Year",
              "why": "Count the dash at index 2."
            },
            {
              "md": "`pid[-4:]`.",
              "title": "Last 4",
              "why": "Negative start counts from the end."
            },
            {
              "md": "```python\npid = 'TX-2026-0451'\nprint(pid[0:2], pid[3:7], pid[-4:], pid[::-1])\n```\n\n```text\nTX 2026 0451 1540-6202-XT\n```",
              "title": "Complete program"
            }
          ],
          "answer": "TX 2026 0451 1540-6202-XT"
        },
        {
          "type": "worked_example",
          "title": "Palindrome check",
          "problem": "Is 'Racecar' a palindrome ignoring case?",
          "steps": [
            {
              "md": "`.lower()` → 'racecar'.",
              "title": "Normalize",
              "why": "Comparisons are case-sensitive."
            },
            {
              "md": "`w[::-1]`.",
              "title": "Reverse"
            },
            {
              "md": "```python\nw = \"Racecar\".lower()\nprint(w == w[::-1])\n```\n\n```text\nTrue\n```",
              "title": "Complete program"
            }
          ],
          "answer": "True"
        }
      ]
    },

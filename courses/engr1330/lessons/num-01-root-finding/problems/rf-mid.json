    "a": {
      "type": "number",
      "value": "m.nl"
    },
    "b": {
      "type": "number",
      "value": "m.nu"
    }
  },
  "hints": [
    "Midpoint first.",
    "Is f(midpoint) positive or negative?",
    "Keep the half with the sign change."
  ],
  "solution": "Midpoint $x_m = [$m.mid]$; $f(x_m)$ is [$m.sign] while $f([$m.l])$ is negative, so the new interval is $[[$m.nl], [$m.nu]]$.",

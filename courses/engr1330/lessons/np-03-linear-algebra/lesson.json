          "type": "worked_example",
          "title": "Matrix product by hand",
          "problem": "Compute $\\begin{bmatrix}2&4\\\\5&3\\end{bmatrix}\\begin{bmatrix}2&1\\\\1&2\\end{bmatrix}$.",
          "steps": [
            {
              "md": "(2·2 + 4·1, 2·1 + 4·2) = (8, 10).",
              "title": "Row 1",
              "why": "Row × column."
            },
            {
              "md": "(5·2 + 3·1, 5·1 + 3·2) = (13, 11).",
              "title": "Row 2"
            },
            {
              "md": "```python\nimport numpy as np\n\nprint(np.array([[2, 4], [5, 3]]) @ np.array([[2, 1], [1, 2]]))\n```\n\n```text\n[[ 8 10]\n [13 11]]\n```",
              "title": "Check"
            }
          ],
          "answer": "[[8, 10], [13, 11]]"
        },
        {
          "type": "worked_example",
          "title": "Three currents",
          "problem": "Solve 2x + y + z = 9, x + 3y + 2z = 13, 3x + 2y + z = 14.",
          "steps": [
            {
              "md": "A = [[2,1,1],[1,3,2],[3,2,1]], B = [9,13,14].",
              "title": "Matrix form",
              "why": "Each row is one equation."
            },
            {
              "md": "`np.linalg.solve(A, B)`.",
              "title": "Solve"
            },
            {
              "md": "```python\nimport numpy as np\n\nA = np.array([[2, 1, 1], [1, 3, 2], [3, 2, 1]])\nB = np.array([9, 13, 14])\nX = np.linalg.solve(A, B)\nprint(np.round(X, 4))\nprint(np.allclose(A @ X, B))\n```\n\n```text\n[2.5 2.5 1.5]\nTrue\n```",
              "title": "Complete program",
              "why": "Check by multiplying back."
            }
          ],
          "answer": "x = 2.5, y = 2.5, z = 1.5."
        }
      ]
    },
